<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- 自定义渠道核心逻辑：与界面框架无关，可单独测试 -->
        <!-- 覆盖 Directory.Build.props 的多目标设置：核心库只需可移植 TFM -->
        <TargetFrameworks></TargetFrameworks>
        <TargetFramework>$(PortableTargetFramework)</TargetFramework>
        <RootNamespace>UniGetUI.Extensions.CustomChannels</RootNamespace>
        <AssemblyName>UniGetUI.Extensions.CustomChannels</AssemblyName>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- JSON 全部走源生成；个别反射式重载在 AOT 裁剪下不可用，已在实现中回退 -->
        <NoWarn>$(NoWarn);CA1416;IL2026;IL3050</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
        <PackageReference Include="SharpCompress" Version="0.40.0" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\SharedAssemblyInfo.cs" Link="SharedAssemblyInfo.cs" />
    </ItemGroup>
</Project>
